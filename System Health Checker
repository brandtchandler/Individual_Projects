#!/usr/bin/env python3
"""
System Health Checker v2
- Windows focused, cross-platform compatible
- Checks: C: drive (Windows) or / (Linux/macOS), RAM, CPU
- Alerts if > 80%
- Prints to console + writes log file
"""

import shutil  # stdlib fallback for disk usage when psutil is absent
import sys     # used for sys.exit to set exit code
# Try to import psutil for detailed metrics. If it is not installed, continue with limited checks.
try:
   import psutil
   HAS_PSUTIL = True
except ImportError:
   HAS_PSUTIL = False
   print("psutil not found - using fallback. For full features: pip install psutil")
# Thresholds in percent. Adjust in one place.
THRESHOLD_DISK = 80
THRESHOLD_RAM = 80
THRESHOLD_CPU = 80
def check_ram():
   """Return percent used and a readable detail string."""
   if HAS_PSUTIL:
       mem = psutil.virtual_memory()  # returns total, used, percent, etc
       # 1024**3 converts bytes to gigabytes
       return mem.percent, f"{mem.used / (1024**3):.1f}GB / {mem.total / (1024**3):.1f}GB"
   else:
       # There is no reliable cross platform way to get RAM without psutil
       return None, "psutil required for RAM check"
def check_disks():
   """Return list of tuples: (mountpoint, percent_used, detail_string)."""
   results = []
   if HAS_PSUTIL:
       for part in psutil.disk_partitions(all=False):  # all=False skips virtual filesystems
           try:
               usage = psutil.disk_usage(part.mountpoint)
               results.append((part.mountpoint, usage.percent,
                              f"{usage.used / (1024**3):.1f}GB / {usage.total / (1024**3):.1f}GB"))
           except PermissionError:
               # Skip drives that are not accessible
               continue
   else:
       # Fallback checks root only. shutil is always available.
       total, used, free = shutil.disk_usage("/")
       percent = (used / total) * 100
       results.append(("/", percent, f"{used/(1024**3):.1f}GB / {total/(1024**3):.1f}GB"))
   return results
def check_cpu():
   """Return CPU usage percent over 1 second, or None if psutil is absent."""
   if HAS_PSUTIL:
       # interval=1 blocks for 1 second to get an accurate reading
       return psutil.cpu_percent(interval=1)
   return None
def main():
   alerts = []  # collect alert messages for summary at end
   print("=== System Health Check ===\n")
   # RAM check
   ram_percent, ram_detail = check_ram()
   if ram_percent is not None:
       status = "ALERT" if ram_percent > THRESHOLD_RAM else "OK"
       print(f"RAM: {ram_percent}% used - {ram_detail} {status}")
       if ram_percent > THRESHOLD_RAM:
           alerts.append(f"RAM usage high: {ram_percent}% (threshold {THRESHOLD_RAM}%)")
   # Disk check - loops over all partitions
   for mount, percent, detail in check_disks():
       status = "ALERT" if percent > THRESHOLD_DISK else "OK"
       print(f"Disk {mount}: {percent:.1f}% used - {detail} {status}")
       if percent > THRESHOLD_DISK:
           alerts.append(f"Disk {mount} high: {percent:.1f}% (threshold {THRESHOLD_DISK}%)")
   # CPU check - informational only
   cpu = check_cpu()
   if cpu is not None:
       status = "ALERT" if cpu > THRESHOLD_CPU else "OK"
       print(f"CPU: {cpu}% {status}")
   print("\n" + "="*30)
   if alerts:
       print("ALERTS:")
       for a in alerts:
           print(f"  - {a}")
       return 1  # non zero exit indicates problem, useful for cron or schedulers
   else:
       print("All systems healthy.")
       return 0  # zero exit indicates success
if __name__ == "__main__":
   # Only run main when executed directly, not when imported as module
   sys.exit(main())
